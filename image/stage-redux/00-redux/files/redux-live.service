[Unit]
Description=Redux passive live Wi-Fi supervisor (single Bettercap owner)
After=local-fs.target redux.service redux-regdom.service captures.mount
Wants=redux-regdom.service captures.mount
# Soft dependency on the REDUXCAP mount (not RequiresMountsFor): when the
# partition is present the service still waits for it (After=captures.mount, no
# race), but when it is absent or fails to mount the service STILL STARTS so the
# loopback read-only Doctor can report the storage outage instead of the whole
# supervisor failing to launch. The runtime refuses to create capture state on
# the root filesystem and serves a storage-paused Doctor until the mount appears.
ConditionPathExists=/etc/redux/live.toml

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/redux
Environment=PYTHONPATH=/opt/redux
Environment=PYTHONUNBUFFERED=1
# Bettercap must never try to create ~/bettercap.aliases in protected /root.
Environment=HOME=/captures/live
UMask=0077
ExecStart=/usr/bin/python3 -m redux.core.live_runtime --config /etc/redux/live.toml
Restart=on-failure
RestartSec=5
# Keep any detached Bettercap session inside the service's cgroup cleanup.
# The Python supervisor never declares a capture closed before reaping it.
KillMode=control-group
RestartKillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/captures
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
