# Validated fbui runtime config for the goodtft tft35a (MPI3501: ILI9486 + XPT2046)
# 3.5" 480x320 SPI panel. Seeded to /captures/config/fbui.env on first boot by
# redux-fbui-seed.service ONLY when it does not already exist, so an operator's
# hand-tuned file is never overwritten.
#
# The tft35a overlay registers the SPI panel as the SECOND framebuffer, so it is
# /dev/fb1 (HDMI/KMS, when present, holds /dev/fb0). Panel rotation is done in
# the overlay (dtoverlay=tft35a:rotate=270), so the fbui's own software rotate
# stays 0. Pixel order for this panel is rgb565.
REDUX_FRAMEBUFFER=/dev/fb1
REDUX_DASHBOARD_PORT=8080
REDUX_PIXEL_ORDER=rgb565
REDUX_ROTATE=0

# Swipe nav works out of the box; TAPS and the interactive control deck need a
# one-time touch calibration. Easiest -- one command does everything:
#   sudo redux-deck-enable
# (It detects the panel, has you tap the four corners + center, writes the
# calibration, sets the line below, and restarts the display.) To do it by hand,
# set this and restart redux-fbui (--confirm-touch-calibration is required):
#   REDUX_FBUI_ARGS=--calibration-file /captures/config/touch-calibration.json --confirm-touch-calibration --deck
# Leave empty for the status pages + swipe nav.
REDUX_FBUI_ARGS=
