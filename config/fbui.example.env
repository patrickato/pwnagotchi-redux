# Copy to /captures/config/fbui.env after actual TFT discovery and review.
# This is an intentionally invalid template and is never installed as active config.
# Replace fbN with the measured framebuffer identity (not guessed fb0/fb1).
REDUX_FRAMEBUFFER=/dev/fbN
REDUX_DASHBOARD_PORT=8080
REDUX_PIXEL_ORDER=rgb565
REDUX_ROTATE=0

# Extra flags appended to the fbui launch (word-split by systemd). Empty = the
# read-only status pages with swipe nav (taps need calibration).
#
# To enable TAPS + the interactive CONTROL DECK, first calibrate the panel once:
#   1. redux-display-diag  --output-dir /captures/config   (tap the 5 crosshairs:
#        top-left, top-right, bottom-left, bottom-right, center) → writes a report
#   2. redux-touch-calibrate --report /captures/config/<report>.json \
#        --output-dir /captures/config --confirm-order  → writes touch-calibration.json
# then set (and `systemctl restart redux-fbui`):
#   REDUX_FBUI_ARGS=--calibration-file /captures/config/touch-calibration.json --deck
# Drop "--deck" to keep the status pages but with working taps.
REDUX_FBUI_ARGS=
